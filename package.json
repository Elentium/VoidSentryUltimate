{
  "name": "voidsentryultimate-repo",
  "private": true,
  "description": "Repo tooling for VoidSentryUltimate (docs, benches, packages)",
  "license": "Apache-2.0",
  "scripts": {
    "docs:sync": "node scripts/sync-moonwave.mjs",
    "docs:build": "node scripts/sync-moonwave.mjs && npx moonwave build --code packages/voidsentryultimate/VoidSentryUltimate.luau && node scripts/sync-moonwave.mjs",
    "docs:clean-cache": "node -e \"const fs=require('fs'),os=require('os'),path=require('path');const p=path.join(os.homedir(),'Library','Caches','moonwave',path.basename(process.cwd()));fs.rmSync(p,{recursive:true,force:true});console.log('Removed',p)\"",
    "docs:dev": "node scripts/sync-moonwave.mjs && npx moonwave dev --code packages/voidsentryultimate/VoidSentryUltimate.luau",
    "docs:dev:watch": "node scripts/sync-moonwave.mjs --watch & npx moonwave dev --code packages/voidsentryultimate/VoidSentryUltimate.luau"
  },
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "^1.0.800",
    "typescript": "^5.0.0"
  }
}
